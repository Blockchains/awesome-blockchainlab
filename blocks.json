{
  "$schema": "https://raw.githubusercontent.com/Blockchains/.github/main/docs/blocks.schema.json",
  "schema_version": "1.0",
  "name": "awesome-blockchainlab",
  "repo": "Blockchains/awesome-blockchainlab",
  "summary": "Curated list of 225 open-source blockchain projects (+11 extended) forked under Blockchains and kept in sync by fork-sync, with a machine-readable forge.json (fork, upstream, category, licence, stars, docs, starters, index links).",
  "kind": [
    "curated-list",
    "dataset"
  ],
  "stability": "stable",
  "license": "CC0-1.0",
  "entrypoints": [
    {
      "type": "file",
      "name": "forge.json",
      "ref": "forge.json",
      "usage": "https://raw.githubusercontent.com/Blockchains/awesome-blockchainlab/main/forge.json"
    },
    {
      "type": "file",
      "name": "README.md",
      "ref": "README.md",
      "usage": "human-readable list by category"
    }
  ],
  "inputs": [],
  "outputs": [
    {
      "name": "projects[]",
      "type": "JSON",
      "description": "slug, name, fork, upstream, category, license, license_note, stars, tier, docs, starters, index {components, repo_index, commit, tags}"
    }
  ],
  "deps": [
    "any JSON reader"
  ],
  "compatible_with": [
    {
      "repo": "Blockchains/fork-sync",
      "how": "keeps every listed fork in sync"
    },
    {
      "repo": "Blockchains/blockchainlab-index",
      "how": "code index of the same forks (projects[].index links)"
    },
    {
      "repo": "Blockchains/blockchainlab-starters",
      "how": "starters built on these forks"
    },
    {
      "repo": "Blockchains/blockchainlab-compose",
      "how": "composes projects from them"
    }
  ],
  "tests": {
    "command": "python3 scripts/validate.py",
    "ci": ".github/workflows/validate.yml",
    "network": true
  },
  "docs": {
    "readme": "README.md",
    "agents": "AGENTS.md",
    "llms": "llms.txt"
  }
}
